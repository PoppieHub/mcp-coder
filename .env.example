MCP_LLM_TOKEN=
MCP_LLM_BASE_URL=https://llm.example.com/api
MCP_LLM_MODEL=coder-medium

# Optional limits. Empty or invalid values fall back to the application defaults.
MCP_MAX_AGENT_STEPS=32
MCP_MAX_PARALLEL_TASKS=2
MCP_MAX_INPUT_CHARS=40000
MCP_MAX_FILE_CHARS=120000
MCP_MAX_TOTAL_CONTEXT_CHARS=400000
MCP_MAX_OUTPUT_TOKENS=3000
MCP_REQUEST_TIMEOUT_MS=60000
MCP_COMMAND_TIMEOUT_MS=60000
MCP_TASK_TIMEOUT_MS=600000
# false disables cache_control markers when the gateway handles them incorrectly.
MCP_PROMPT_CACHE=true
